{
  "title": "FlowCart Overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "uid": "flowcart-overview",
  "tags": ["flowcart"],
  "panels": [
    {
      "type": "timeseries",
      "title": "HTTP request rate",
      "id": 1,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(rate(http_server_requests_seconds_count[1m])) by (uri)", "legendFormat": "{{uri}}"}]
    },
    {
      "type": "timeseries",
      "title": "JVM memory used",
      "id": 2,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "jvm_memory_used_bytes", "legendFormat": "{{area}}"}]
    },
    {
      "type": "stat",
      "title": "Reservation failures",
      "id": 3,
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "flowcart_reservation_failures_total"}]
    },
    {
      "type": "stat",
      "title": "Payment failures",
      "id": 4,
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "flowcart_payment_failures_total"}]
    },
    {
      "type": "timeseries",
      "title": "Order latency",
      "id": 5,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "rate(flowcart_order_latency_seconds_sum[1m])", "legendFormat": "order latency"}]
    }
  ]
}
